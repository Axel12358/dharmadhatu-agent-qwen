import asyncio
from playwright.async_api import async_playwright
from bs4 import BeautifulSoup
import re
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

async def extract_events(url):
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True, args=['--no-sandbox'])
        page = await browser.new_page()
        await page.goto(url, timeout=30 * 1000)
        await page.wait_for_selector(".x1lkfr7t", timeout=10000)

        events = []
        while True:
            html_content = await page.content()
            soup = BeautifulSoup(html_content, 'html.parser')

            event_items = soup.select('.x3jane.xa425dw.x1s688fe.x1lqespi.x9fny7w.x1jaq5fi.x1qjcudd.x2hbiel')
            if not event_items:
                event_items = soup.select('a[href*="/events/"]')
            
            for item in event_items:
                href = item.get('href')
                if href and '/events/' in href:
                    if not href.startswith('http'):
                        href = 'https://www.facebook.com' + href
                    events.append(href)

            load_more = soup.select('.x6s0dn4.xjz9t2n.x1fcty3u')
            if not load_more:
                break

            try:
                await page.click(load_more[0])
                await asyncio.sleep(5)
            except:
                break

        await browser.close()
        return events

async def extract_event_details(url):
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True, args=['--no-sandbox'])
        page = await browser.new_page()
        await page.goto(url, timeout=30 * 1000)
        await page.wait_for_selector(".x1lkfr7t", timeout=10000)

        html_content = await page.content()
        soup = BeautifulSoup(html_content, 'html.parser')

        # Título
        title = soup.select_one('.x1lkfr7t.xh8yej3.xw28xxk.x1i10hfl.x193wmn4')
        if not title:
            title = soup.select_one('h1, h2, [class*="title"]')
        
        # Organizador
        host = soup.select_one('.x1lkfr7t.xh8yej3.xw28xxk.x1i10hfl.xe1xjs5')
        if not host:
            host = soup.select_one('[class*="host"], [class*="organizer"]')
            if not host:
                # Buscar "Hosted by" en el texto
                texto = soup.get_text()
                match = re.search(r'Hosted by\s*([^\n]+)', texto)
                if match:
                    host_text = match.group(1).strip()
                    return {
                        'title': title.text.strip() if title else 'Sin título',
                        'host': host_text
                    }

        await browser.close()
        return {
            'title': title.text.strip() if title else 'Sin título',
            'host': host.text.strip() if host else 'No disponible'
        }

async def scrape_facebook_public(config):
    """Función principal que usa el nuevo scraper de Qwen."""
    query = "psytrance festival"
    url = f"https://www.facebook.com/events/search/?q={query.replace(' ', '+')}"
    
    logger.info(f"🔍 Buscando eventos en Facebook: {query}")
    
    try:
        eventos_urls = await extract_events(url)
        logger.info(f"✅ Encontrados {len(eventos_urls)} enlaces de eventos")
        
        eventos = []
        for i, event_url in enumerate(eventos_urls[:config.get('max_eventos', 150)]):
            try:
                detalles = await extract_event_details(event_url)
                if detalles:
                    eventos.append({
                        'nombre': detalles.get('title', 'Sin nombre'),
                        'fecha': 'Fecha no disponible',
                        'lugar': 'Lugar no disponible',
                        'organizador': detalles.get('host', 'No disponible'),
                        'enlace': event_url,
                        'fuente': 'Facebook (Qwen)'
                    })
                    logger.info(f"   ✅ Evento {i+1}: {detalles.get('title', 'Sin título')[:30]}...")
            except Exception as e:
                logger.warning(f"   ⚠️ Error extrayendo detalles: {e}")
        
        logger.info(f"✅ Facebook: {len(eventos)} eventos reales")
        return eventos
    except Exception as e:
        logger.error(f"❌ Error en Facebook: {e}")
        return []
