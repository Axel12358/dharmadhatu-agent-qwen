import asyncio
import random
import logging
from playwright.async_api import async_playwright
from .strategies import get_events
from .anti_detection import apply_anti_detection
from .fallback import guardar_configuracion, cargar_configuraciones

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def generar_queries_facebook(config):
    """Genera queries combinando países, subgéneros, tipos y ciudades."""
    queries = []
    paises = config.get("priorizar_paises", [])
    subgeneros = config.get("subgeneros", ["psytrance"])
    tipos = config.get("tipos_evento", ["festival"])
    ciudades = config.get("ciudades", [])
    
    # Combinaciones básicas
    for sub in subgeneros:
        for tipo in tipos:
            queries.append(f"{sub} {tipo}")
            for pais in paises:
                queries.append(f"{sub} {tipo} {pais}")
            for ciudad in ciudades:
                queries.append(f"{sub} {tipo} {ciudad}")
    
    # Términos fijos
    terminos = [
        "psytrance festival", "goa party", "psytrance gathering",
        "outdoor psytrance", "indoor psytrance", "psytrance rave"
    ]
    queries.extend(terminos)
    
    random.shuffle(queries)
    max_queries = config.get("busquedas_facebook", 50)
    queries = queries[:max_queries]
    logger.info(f"🔍 Generadas {len(queries)} queries")
    return queries

async def scrape_facebook_public(config):
    """Scraper de Facebook con estrategias múltiples y anti-detección."""
    queries = generar_queries_facebook(config)
    max_eventos = config.get("max_eventos", 150)
    
    all_events = []
    seen_links = set()
    
    # Cargar configuraciones previas (fallback)
    configs_previas = cargar_configuraciones()
    if configs_previas:
        logger.info(f"📂 Cargadas {len(configs_previas)} configuraciones previas")
    
    for query in queries[:config.get("busquedas_facebook", 20)]:
        logger.info(f"🔎 Buscando: {query}")
        
        try:
            # Obtener eventos con las estrategias
            eventos = await get_events(query, config)
            
            for evento in eventos:
                enlace = evento.get('enlace', '')
                if enlace and enlace not in seen_links:
                    seen_links.add(enlace)
                    all_events.append(evento)
                    if len(all_events) >= max_eventos:
                        break
            
            if all_events:
                logger.info(f"   ✅ Total: {len(all_events)} eventos")
                break  # Si encontramos eventos, no seguimos buscando
        except Exception as e:
            logger.warning(f"   ⚠️ Error en query {query}: {e}")
        
        await asyncio.sleep(random.uniform(2, 5))
    
    # Limitar a max_eventos
    if len(all_events) > max_eventos:
        all_events = all_events[:max_eventos]
    
    # Si encontramos eventos, guardar configuración (para fallback futuro)
    if all_events:
        guardar_configuracion(config, len(all_events), len(all_events), 0)
    
    logger.info(f"✅ Facebook: {len(all_events)} eventos reales")
    return all_events
